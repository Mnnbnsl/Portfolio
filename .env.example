# Resend API key for the contact form.
# Create an account at https://resend.com, verify mananbansal.dev as a sending
# domain, then copy the API key here. Also set the same variable in your Vercel
# project settings — without it the form returns a friendly error and points the
# visitor at the direct email link instead.
RESEND_API_KEY=

# Optional overrides. Defaults are shown.
# CONTACT_TO_EMAIL=manan.bansal0302@gmail.com
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
